<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    {%- set current_path = "" if lang == config.default_language else "/" ~ lang %}
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#5b89b4"/>
    <title>{{ data.profile.full_name }}{% if data.about.tagline %} — {{ data.about.tagline }}{% endif %}</title>
    <meta name="author" content="{{ data.profile.full_name }}"/>
    {% if data.about.tagline %}<meta name="description" content="{{ data.about.tagline }} — {{ data.about.content | default('', true) | oneline | truncate(160, True) }}"/>{% endif %}

    <!-- Open Graph -->
    <meta property="og:type" content="profile"/>
    <meta property="og:title" content="{{ data.profile.full_name }}{% if data.about.tagline %} — {{ data.about.tagline }}{% endif %}"/>
    {% if data.about.content %}<meta property="og:description" content="{{ data.about.content | oneline | truncate(200, True) }}"/>{% endif %}
    {% if deploy.url %}<meta property="og:url" content="{{ deploy.url }}{{ current_path }}/"/>{% endif %}
    {% if deploy.url and social_preview %}<meta property="og:image" content="{{ deploy.url }}{{ current_path }}/{{ social_preview }}"/>{% endif %}
    <meta property="og:locale" content="{{ lang }}"/>
    {% for other_lang in config.languages if other_lang != lang %}
    <meta property="og:locale:alternate" content="{{ other_lang }}"/>
    {% endfor %}
    <meta property="profile:first_name" content="{{ data.profile.first_name }}"/>
    <meta property="profile:last_name" content="{{ data.profile.last_name }}"/>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="{{ data.profile.full_name }}{% if data.about.tagline %} — {{ data.about.tagline }}{% endif %}"/>
    {% if data.about.content %}<meta name="twitter:description" content="{{ data.about.content | oneline | truncate(200, True) }}"/>{% endif %}
    {% if deploy.url and social_preview %}<meta name="twitter:image" content="{{ deploy.url }}{{ current_path }}/{{ social_preview }}"/>{% endif %}

    {% if inline_css %}
    <style>{{ inline_css | safe }}</style>
    {% else %}
    <link rel="stylesheet" type="text/css" href="{{ root }}/style/web.css"/>
    {% endif %}
    <link rel="stylesheet" type="text/css" href="{{ root }}/style/print.css" media="print"/>
    {% if pdf %}<link rel="stylesheet" type="text/css" href="{{ root }}/style/pdf.css" media="print"/>{% endif %}
    {%- for fav in favicons %}
    {%- if fav.format == "ico" %}
    <link rel="icon" type="{{ fav.mime_type }}" href="{{ root }}/images/{{ fav.filename }}"/>
    {%- elif fav.rel and fav.prefix != "mstile" %}
    <link rel="{{ fav.rel }}" type="{{ fav.mime_type }}" sizes="{{ fav.sizes }}" href="{{ root }}/images/{{ fav.filename }}"/>
    {%- endif %}
    {%- endfor %}
    {%- for l in config.languages  %}
    {%- set lang_path = "" if l == config.default_language else "/" ~ l %}
    <link rel="alternate" hreflang="{{ l }}" href="{{ deploy.url }}{{ lang_path }}/" />
    {%- endfor %}
    {%- if deploy.url %}
    <link rel="canonical" href="{{ deploy.url }}{{ current_path }}/" />
    {%- endif %}

    {% if deploy.google_analytics %}
    <!-- Google Analytics – deferred until idle to reduce TBT -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin/>
    <script>
      function _loadGA(){
        var s=document.createElement('script');
        s.src='https://www.googletagmanager.com/gtag/js?id={{ deploy.google_analytics }}';
        s.async=true;
        document.head.appendChild(s);
        window.dataLayer=window.dataLayer||[];
        function gtag(){dataLayer.push(arguments);}
        gtag('js',new Date());
        gtag('config','{{ deploy.google_analytics }}');
      }
      if(typeof requestIdleCallback==='function'){requestIdleCallback(_loadGA)}
      else{setTimeout(_loadGA,2000)}
    </script>
    {% endif %}
    {% if jsonld %}
    <script type="application/ld+json">{{ jsonld | safe }}</script>
    {% endif %}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{{ _('Skip to main content') }}</a>
    {# WeasyPrint's SVG renderer does not resolve CSS fill:currentColor,
       so we pass explicit fill colors for the PDF version. #}
    {% set header_icon_color = "rgba(255,255,255,0.8)" if pdf else "" %}
    {% set sidebar_icon_color = "#3d6891" if pdf else "" %}
    <div class="resume">

      <!-- ═══════════════ HEADER ═══════════════ -->
      <header class="header">
        <div class="header-identity">
          {% if avatar_webp and avatar_png %}
          <picture>
            <source srcset="{{ root }}/images/{{ avatar_webp }}" type="image/webp"/>
            <img class="avatar" src="{{ root }}/images/{{ avatar_png }}" alt="{{ data.profile.full_name }}" width="88" height="88" fetchpriority="high"/>
          </picture>
          {% else %}
          <img class="avatar" src="{{ root }}{{ data.profile.avatar or '/images/me1.png' }}" alt="{{ data.profile.full_name }}" width="88" height="88" fetchpriority="high"/>
          {% endif %}
          <div class="header-name">
            <h1>{{ data.profile.full_name }}</h1>
            {% if data.about.tagline %}<p class="tagline">{{ data.about.tagline }}</p>{% endif %}
          </div>
        </div>
        <div class="header-contacts">
          {% if data.profile.phone %}
          <div class="header-contact-item">
            <div class="contact-text">
              {{ icon("phone", color=header_icon_color) }}
              <a href="tel:{{ data.profile.phone.number }}" class="contact-value">
                {{ data.profile.phone.display }}
              </a>
            </div>
          </div>
          {% endif %}
          {% if data.profile.email %}
          <div class="header-contact-item">
            <div class="contact-text">
              {{ icon("envelope", color=header_icon_color) }}
              <a href="mailto:{{ data.profile.email }}" class="contact-value">
                {{ data.profile.email }}
              </a>
            </div>
          </div>
          {% endif %}
          <div class="header-contact-item no-print">
            <nav aria-label="{{ _('Actions') }}">
              <a href="./{{ data.profile.pdf_filename }}" class="contact-value pdf" rel="alternate" download type="application/pdf" aria-label="{{ _('Download PDF') }}">
                {{ icon("pdf") }}
              </a>
              <div class="contact-text languages">
                {{ icon("language") }}
                {%- for other_lang in config.languages  %}
                {%- if other_lang != lang %}
                {%- set other_path = "/" if other_lang == config.default_language else "/" ~ other_lang ~ "/" %}
                <a href="{{ other_path }}" class="contact-value" rel="alternate" hreflang="{{ other_lang }}">{{ other_lang }}</a>
                {%- endif %}
                {%- endfor %}
              </div>
            </nav>
          </div>
          <div class="header-contact-item print-only">
            <div class="contact-text">
              {{ icon("globe", color=header_icon_color) }}
              <a href="{{ deploy.url }}" class="contact-value">
                {{ deploy.url }}
              </a>
            </div>
          </div>
        </div>
      </header>

      <!-- ═══════════════ BODY ═══════════════ -->
      <div class="body">

        <!-- ─── LEFT SIDEBAR ─── -->
        <aside class="sidebar" aria-label="{{ _('About Me') }}">

          <!-- About Me -->
          {% if data.about.html %}
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('About Me') }}</h2>
            <div class="about-text">{{ data.about.html | safe }}</div>
          </section>
          {% endif %}

          <!-- Education -->
          {% if data.schools %}
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Education') }}</h2>
            {% for school in data.schools %}
            <div class="edu-entry">
              <strong>{{ school.section or school.degree or school.name }}</strong>
              {% if school.section or school.degree %}
              <span class="edu-school">{{ school.name }}{% if school.where %}, {{ school.where }}{% endif %}</span>
              {% endif %}
              <span class="edu-year">
                {% if school.from_year and school.to_year %}{{ school.from_year }} – {{ school.to_year }}
                {% elif school.when %}{{ school.when }}
                {% endif %}
              </span>
            </div>
            {% endfor %}
          </section>
          {% endif %}

          <!-- Languages -->
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Languages') }}</h2>
            <table class="info-table">
              <caption class="sr-only">{{ _('Languages') }}</caption>
              {% for lang_info in data.about.languages %}
              <tr>
                <th>{{ lang_info.name }}</th>
                <td>{{ lang_info.level }}</td>
              </tr>
              {% endfor %}
            </table>
          </section>

          <!-- Online & Social -->
          {% if data.profile.social or data.profile.websites %}
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Online Profile') }}</h2>
            <nav aria-label="{{ _('Online Profile') }}">
            {% for sn in data.profile.social %}
            <div class="online-item">
              {{ icon(sn.icon or sn.name | lower, color=sidebar_icon_color) }}
              <a href="{{ sn.link }}" target="_blank" rel="{% if sn.name | lower == 'mastodon' %}me {% endif %}noopener">
                <span class="no-print">{{ sn.name }}</span>
                <span class="print-only">{{ sn.link | strip_protocol }}</span>
              </a>
            </div>
            {% endfor %}
            {% for site in data.profile.websites %}
            <div class="online-item">
              {{ icon("globe", color=sidebar_icon_color) }}
              <a href="{{ site.link }}" target="_blank" rel="noopener">
                <span class="no-print">{{ site.name }}</span>
                <span class="print-only">{{ site.link | strip_protocol }}</span>
              </a>
            </div>
            {% endfor %}
            </nav>
          </section>
          {% endif %}

          <!-- QR Code (print/PDF only) -->
          {% if deploy.url %}
          <section class="sidebar-section sidebar-qrcode print-only">
            <a href="{{ deploy.url }}">
              <img class="qrcode" src="{{ root }}/images/qrcode.png" alt="QR Code: {{ deploy.url }}" width="150" height="150" loading="lazy"/>
            </a>
          </section>
          {% endif %}


        </aside>

        <!-- ─── TIMELINE (middle) ─── -->
        <main id="main-content" class="timeline-col">
          <h2 class="section-title">{{ _('Experience') }}</h2>
          <div class="timeline">
            {% for exp in data.experiences %}
            <div class="timeline-entry">
              <div class="timeline-year-badge">{% if exp.start %}<time datetime="{{ exp.start.strftime('%Y') }}">{{ exp.start.strftime('%Y') }}</time>{% else %}?{% endif %}</div>
              <div class="timeline-content">
                <h3 class="timeline-role">{{ exp.role or exp.company }}</h3>
                <div class="timeline-meta">
                  {% if exp.url %}<a href="{{ exp.url }}">{{ exp.company }}</a>{% else %}{{ exp.company }}{% endif %}{% if exp.location %}, {{ exp.location }}{% endif %}
                </div>
                {% if exp.html %}
                <div class="timeline-desc">{{ exp.html | safe }}</div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
        </main>

        <!-- ─── RIGHT COLUMN ─── -->
        <aside class="rightcol" aria-label="{{ _('Skills') }}">

          <!-- Skills -->
          {% if data.skill_groups %}
          <section class="rightcol-section">
            <h2 class="section-title">{{ _('Skills') }}</h2>
            {% for group in data.skill_groups %}
            <div class="skill-group">
              <h3>{{ _(group.name) }}</h3>
              {% for s in group.skills %}
              <div class="skill-item">
                <span class="skill-name">{{ _(s.name) }}</span>
                <div class="skill-bar-bg" role="img" aria-label="{{ _(s.name) }}: {{ s.level }}%"><div class="skill-bar-fill" style="width: {{ s.level }}%"></div></div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </section>
          {% endif %}


        </aside>
      </div><!-- .body -->
    </div><!-- .resume -->
  </body>
</html>
