<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8"/>
    <title>{{ data.profile.full_name }}</title>
    <link rel="stylesheet" type="text/css" href="{{ root }}/style/web.css"/>
    <link rel="stylesheet" type="text/css" href="{{ root }}/style/print.css" media="print"/>
    {% if pdf %}<link rel="stylesheet" type="text/css" href="{{ root }}/style/pdf.css" media="print"/>{% endif %}
    {%- for fav in favicons %}
    {%- if fav.format == "ico" %}
    <link rel="icon" type="{{ fav.mime_type }}" href="{{ root }}/images/{{ fav.filename }}"/>
    {%- elif fav.rel and fav.prefix != "mstile" %}
    <link rel="{{ fav.rel }}" type="{{ fav.mime_type }}" sizes="{{ fav.sizes }}" href="{{ root }}/images/{{ fav.filename }}"/>
    {%- endif %}
    {%- endfor %}
    {%- for other_lang in config.languages  %}
    {%- if other_lang != lang %}
    <link rel="alternate" hreflang="{{ other_lang }}" href="/{{ other_lang }}" />
    {%- endif %}
    {%- endfor %}

    {% if deploy.google_analytics %}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ deploy.google_analytics }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ deploy.google_analytics }}');
    </script>
    {% endif %}
  </head>
  <body>
    {# WeasyPrint's SVG renderer does not resolve CSS fill:currentColor,
       so we pass explicit fill colors for the PDF version. #}
    {% set header_icon_color = "rgba(255,255,255,0.8)" if pdf else "" %}
    {% set sidebar_icon_color = "#3d6891" if pdf else "" %}
    <div class="resume">

      <!-- ═══════════════ HEADER ═══════════════ -->
      <header class="header">
        <div class="header-identity">
          <img class="avatar" src="{{ root }}{{ data.profile.avatar or '/images/me1.png' }}" alt="{{ data.profile.full_name }}"/>
          <div class="header-name">
            <h1>{{ data.profile.full_name }}</h1>
            {% if data.about.tagline %}<p class="tagline">{{ data.about.tagline }}</p>{% endif %}
          </div>
        </div>
        <div class="header-contacts">
          {% if data.profile.phone %}
          <div class="header-contact-item">
            <div class="contact-text">
              {{ icon("phone", color=header_icon_color) }}
              <a href="tel:{{ data.profile.phone.number }}" class="contact-value">
                {{ data.profile.phone.display }}
              </a>
            </div>
          </div>
          {% endif %}
          {% if data.profile.email %}
          <div class="header-contact-item">
            <div class="contact-text">
              {{ icon("envelope", color=header_icon_color) }}
              <a href="mailto:{{ data.profile.email }}" class="contact-value">
                {{ data.profile.email }}
              </a>
            </div>
          </div>
          {% endif %}
          <div class="header-contact-item no-print">
              <a href="./{{ data.profile.pdf_filename }}" class="contact-value" rel="alternate" download type="application/pdf">
                {{ icon("pdf") }}
              </a>
              <div class="contact-text languages">
                {{ icon("language") }}
              {%- for other_lang in config.languages  %}
              {%- if other_lang != lang %}
              <a href="/{{ other_lang }}/" class="contact-value" rel="alternate" hreflang="{{ other_lang }}">{{ other_lang }}</a>
              {%- endif %}
              {%- endfor %}
              </div>
          </div>
          <div class="header-contact-item print-only">
            <div class="contact-text">
              {{ icon("globe", color=header_icon_color) }}
              <a href="{{ deploy.url }}" class="contact-value">
                {{ deploy.url }}
              </a>
            </div>
          </div>
        </div>
      </header>

      <!-- ═══════════════ BODY ═══════════════ -->
      <div class="body">

        <!-- ─── LEFT SIDEBAR ─── -->
        <aside class="sidebar">

          <!-- Personal -->
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Personal') }}</h2>
            <table class="info-table">
              <tr>
                <th>{{ _('Name') }}</th>
                <td>{{ data.profile.full_name }}</td>
              </tr>
              {% if data.profile.email %}
              <tr>
                <th>{{ _('Email') }}</th>
                <td><a href="mailto:{{ data.profile.email }}">{{ data.profile.email }}</a></td>
              </tr>
              {% endif %}
              {% if data.profile.phone %}
              <tr>
                <th>{{ _('Phone') }}</th>
                <td><a href="tel:{{ data.profile.phone.number }}">{{ data.profile.phone.display }}</a></td>
              </tr>
              {% endif %}
              {% for lang_info in data.about.languages %}
              <tr>
                <th>{{ lang_info.name }}</th>
                <td>{{ lang_info.level }}</td>
              </tr>
              {% endfor %}
            </table>
          </section>

          <!-- Education -->
          {% if data.schools %}
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Education') }}</h2>
            {% for school in data.schools %}
            <div class="edu-entry">
              <strong>{{ school.section or school.degree or school.name }}</strong>
              {% if school.section or school.degree %}
              <span class="edu-school">{{ school.name }}{% if school.where %}, {{ school.where }}{% endif %}</span>
              {% endif %}
              <span class="edu-year">
                {% if school.from_year and school.to_year %}{{ school.from_year }} – {{ school.to_year }}
                {% elif school.when %}{{ school.when }}
                {% endif %}
              </span>
            </div>
            {% endfor %}
          </section>
          {% endif %}

          <!-- Rated Skills -->
          {% set rated_skills = data.profile.skills or data.about.skills %}
          {% if rated_skills %}
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Skills') }}</h2>
            {% for s in rated_skills %}
            <div class="skill-item">
              <label>{{ s.name }}</label>
              <div class="skill-bar-bg"><div class="skill-bar-fill" style="width: {{ s.rate }}%"></div></div>
            </div>
            {% endfor %}
          </section>
          {% endif %}

          <!-- Online & Social -->
          {% if data.profile.social or data.profile.websites %}
          <section class="sidebar-section">
            <h2 class="section-title">{{ _('Online Profile') }}</h2>
            {% for sn in data.profile.social %}
            <div class="online-item">
              {{ icon(sn.icon or sn.name | lower, color=sidebar_icon_color) }}
              <a href="{{ sn.link }}" target="_blank" rel="noopener">
                <span class="no-print">{{ sn.name }}</span>
                <span class="print-only">{{ sn.link | strip_protocol }}</span>
              </a>
            </div>
            {% endfor %}
            {% for site in data.profile.websites %}
            <div class="online-item">
              {{ icon("globe", color=sidebar_icon_color) }}
              <a href="{{ site.link }}" target="_blank" rel="noopener">
                <span class="no-print">{{ site.name }}</span>
                <span class="print-only">{{ site.link | strip_protocol }}</span>
              </a>
            </div>
            {% endfor %}
          </section>
          {% endif %}

          <!-- QR Code (print/PDF only) -->
          {% if deploy.url %}
          <section class="sidebar-section sidebar-qrcode print-only">
            <a href="{{ deploy.url }}">
              <img class="qrcode" src="{{ root }}/images/qrcode.png" alt="QR Code: {{ deploy.url }}"/>
            </a>
          </section>
          {% endif %}


        </aside>

        <!-- ─── TIMELINE (middle) ─── -->
        <main class="timeline-col">
          <h2 class="section-title">{{ _('Experience') }}</h2>
          <div class="timeline">
            {% for exp in data.experiences %}
            <div class="timeline-entry">
              <div class="timeline-year-badge">{{ exp.start.strftime('%Y') if exp.start else '?' }}</div>
              <div class="timeline-content">
                <h3 class="timeline-role">{{ exp.role or exp.company }}</h3>
                <div class="timeline-meta">
                  {{ exp.company }}{% if exp.location %}, {{ exp.location }}{% endif %}
                </div>
                {% if exp.html %}
                <div class="timeline-desc">{{ exp.html | safe }}</div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
        </main>

        <!-- ─── RIGHT COLUMN ─── -->
        <aside class="rightcol">

          <!-- About Me -->
          {% if data.about.html %}
          <section class="rightcol-section">
            <h2 class="section-title">{{ _('About Me') }}</h2>
            <div class="about-text">{{ data.about.html | safe }}</div>
          </section>
          {% endif %}

          <!-- Expertise -->
          {% if data.expertise %}
          <section class="rightcol-section">
            <h2 class="section-title">{{ _('Expertise') }}</h2>
            {% for ex in data.expertise %}
            <div class="expertise-group">
              <h3>{{ ex.name }}</h3>
              <ul>
                {% for line in ex.lines %}<li>{{ line }}</li>{% endfor %}
              </ul>
            </div>
            {% endfor %}
          </section>
          {% endif %}

          <!-- Skill Groups -->
          {% if data.skill_groups %}
          <section class="rightcol-section">
            <h2 class="section-title">{{ _('Technical Skills') }}</h2>
            {% for group in data.skill_groups %}
            <div class="skill-group">
              <h3>{{ group.name }}</h3>
              {% for s in group.skills %}
              <div class="skill-item">
                <label>{{ s.name }}</label>
                <div class="skill-bar-bg"><div class="skill-bar-fill" style="width: {{ s.level }}%"></div></div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </section>
          {% endif %}

          <!-- Projects -->
          {% if data.projects %}
          <section class="rightcol-section">
            <h2 class="section-title">{{ _('Projects') }}</h2>
            <ul class="projects-list">
              {% for p in data.projects %}
              <li>
                <a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>
                {% if p.description %}<span>: {{ p.description }}</span>{% endif %}
              </li>
              {% endfor %}
            </ul>
          </section>
          {% endif %}

        </aside>
      </div><!-- .body -->
    </div><!-- .resume -->
  </body>
</html>
