<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8"/>
  <style>
    @page {
      size: 1200px 630px;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      width: 1200px;
      height: 630px;
      font-family: "PT Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
      color: #ffffff;
      background: linear-gradient(135deg, #3d6891 0%, #5b89b4 50%, #7ba3c8 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      position: relative;
    }

    /* Subtle geometric decoration */
    body::before {
      content: "";
      position: absolute;
      top: -80px;
      right: -80px;
      width: 320px;
      height: 320px;
      border: 3px solid rgba(255, 255, 255, 0.08);
      border-radius: 50%;
    }

    body::after {
      content: "";
      position: absolute;
      bottom: -60px;
      left: -60px;
      width: 240px;
      height: 240px;
      border: 3px solid rgba(255, 255, 255, 0.06);
      border-radius: 50%;
    }

    .card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      z-index: 1;
    }

    .avatar {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 4px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
      object-fit: cover;
    }

    .name {
      font-size: 56px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      line-height: 1.1;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .tagline {
      font-size: 28px;
      font-weight: 400;
      opacity: 0.9;
      letter-spacing: 0.5px;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .separator {
      width: 80px;
      height: 3px;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 2px;
    }

    .url {
      font-size: 20px;
      opacity: 0.7;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="card">
    <img class="avatar" src="{{ avatar }}" alt="{{ data.profile.full_name }}"/>
    <h1 class="name">{{ data.profile.full_name }}</h1>
    {% if data.about.tagline %}
    <p class="tagline">{{ data.about.tagline }}</p>
    {% endif %}
    <div class="separator"></div>
    <p class="url">{{ url }}</p>
  </div>
</body>
</html>
