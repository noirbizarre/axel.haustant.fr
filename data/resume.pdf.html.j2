<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <title>{{ data.me.full_name }} - {{ data.me.tagline }}</title>
    <link rel="stylesheet" type="text/css" href="/style/pdf.css"/>
    <style>
      body { font-family: sans-serif; font-size: 12px; }
      h1,h2,h3 { margin: 0 0 4px; }
      h1 { font-size: 22px; }
      h2 { font-size: 16px; border-bottom: 1px solid #999; padding-bottom:2px; margin-top:18px; }
      h3 { font-size: 13px; }
      .header { display:flex; justify-content: space-between; align-items:flex-start; }
      .contact, .social { list-style:none; padding:0; margin:0; }
      .section { margin-bottom: 10px; }
      .skills-bars span { display:inline-block; min-width:140px; }
      .skills-bars .bar { display:inline-block; height:6px; background:#ddd; width:160px; position:relative; }
      .skills-bars .bar .fill { background:#333; height:100%; }
      .exp { margin-bottom:10px; }
      .exp-dates { color:#555; font-size:11px; }
      .projects ul, .expertise ul { margin:0; padding-left:16px; }
      .two-col { display:flex; gap:24px; }
      .two-col > div { flex:1; }
      .page-break { page-break-before: always; }
    </style>
  </head>
  <body>
    <div class="header">
      <div>
        <h1>{{ data.me.full_name }}</h1>
        {% if data.me.tagline %}<p>{{ data.me.tagline }}</p>{% endif %}
      </div>
      <div>
        <ul class="contact">
          {% if data.me.email %}<li>{{ data.me.email }}</li>{% endif %}
          {% if data.me.phone and data.me.phone.display %}<li>{{ data.me.phone.display }}</li>{% endif %}
          {% for w in data.me.websites %}<li>{{ w.name }}: {{ w.link }}</li>{% endfor %}
        </ul>
        <ul class="social">
          {% for sn in data.me.social %}<li>{{ sn.display or sn.name }}: {{ sn.link }}</li>{% endfor %}
        </ul>
      </div>
    </div>

    {% if data.me.html %}
    <div class="section" id="summary">
      <h2>{{ data.labels.get('Career Profile','Summary') }}</h2>
      {{ data.me.html | safe }}
    </div>
    {% endif %}

    <div class="two-col">
      <div>
        <div class="section" id="education">
          <h2>{{ data.labels.get('Education','Education') }}</h2>
          {% for school in data.schools %}
            <p><strong>{{ school.name }}</strong>
            {% if school.section %} – {{ school.section }}{% endif %}
            {% if school.degree %} – {{ school.degree }}{% endif %}<br/>
            {% if school.from_year and school.to_year %}{{ school.from_year }} - {{ school.to_year }}{% elif school.when %}{{ school.when }}{% endif %}
            </p>
          {% endfor %}
        </div>

        {% if data.skill_groups %}
        <div class="section" id="skills-grouped">
          <h2>{{ data.labels.get('Skills & Proficiency','Skills') }}</h2>
          {% for group in data.skill_groups %}
            <h3>{{ group.name }}</h3>
            <div class="skills-bars">
            {% for s in group.skills %}
              <div><span>{{ s.name }}</span><div class="bar"><div class="fill" style="width:{{ s.level }}%"></div></div></div>
            {% endfor %}
            </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if data.expertise %}
        <div class="section expertise" id="expertise">
          <h2>{{ data.labels.get('Area of expertise','Expertise') }}</h2>
          {% for ex in data.expertise %}
            <h3>{{ ex.name }}</h3>
            <ul>
              {% for line in ex.lines %}<li>{{ line }}</li>{% endfor %}
            </ul>
          {% endfor %}
        </div>
        {% endif %}

        {% if data.projects %}
        <div class="section projects" id="projects">
          <h2>{{ data.labels.get('Projects','Projects') }}</h2>
          <ul>
            {% for p in data.projects %}
              <li><strong>{{ p.name }}</strong>{% if p.description %}: {{ p.description }}{% endif %} {% if p.url %}({{ p.url }}){% endif %}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
      <div>
        <div class="section experiences" id="experiences">
          <h2>{{ data.labels.get('Experiences','Experiences') }}</h2>
          {% for exp in data.experiences %}
            <div class="exp">
              <strong>{{ exp.company }}{% if exp.role %} – {{ exp.role }}{% endif %}</strong><br/>
              <span class="exp-dates">{% if exp.start %}{{ exp.start.strftime('%Y-%m') }}{% endif %} – {% if exp.end %}{{ exp.end.strftime('%Y-%m') }}{% else %}{{ data.labels.get('Present','Present') }}{% endif %}{% if exp.where %} · {{ exp.where }}{% endif %}</span>
              {% if exp.html %}
                {{ exp.html | safe }}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </body>
</html>
